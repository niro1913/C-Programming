#include<stdio.h>
#include<string.h>
int main(){
    char gender[10];
    int hrs;
    int s;
    scanf("%s",gender);
    scanf("%d",&hrs);
    if((strcmp(gender,"Male")==0)||(strcmp(gender,"MALE")==0)||(strcmp(gender,"male")==0)){
        if(hrs<=8){
            s=hrs*80;
        }else if(hrs>8){
          s=(hrs*80)+((hrs-8)+100);
        }
        printf("Total salary: %d",s);
    }
    else if((strcmp(gender,"Female")==0)||(strcmp(gender,"FEMALE")==0)||(strcmp(gender,"female")==0)){
        if(hrs<=8){
            s=hrs*80;
        }else if(hrs>8){
          s=(hrs*80)+((hrs-8)+100);
        }
        printf("Total salary: %d",s);
    }
    else 
    printf("Invalid input");
    return 0;

}
